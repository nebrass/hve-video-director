# macOS Finder metadata
.DS_Store

# HyperFrames render caches and verification outputs
.hyperframes/
**/.hyperframes/

# Voiceover artifacts — should only ever exist inside example/ or a generated
# project directory, never at repo root. Catches accidental script runs from
# the wrong cwd.
/voiceover.mp3
/voiceover-normalized.mp3
/voiceover-with-music.mp3
/vo_section_*.mp3
/transcript.json
/voiceover.srt
/voiceover.vtt
/voiceover.tsv
/voiceover.txt
/captions-review.json
/captions-review.previous.json
/.hve/captions-state.json
/out/final.srt
/out/final.vtt
/background-music.mp3

# Node
node_modules/

# Python
__pycache__/
*.pyc
*.pyo

# IDE
.vscode/
.idea/

# Agent session state (local runtime, not source)
.omo/

# Throwaway render/verify harnesses; keep only the stdlib test entrypoint/suite
test/*
!test/run.sh
!test/install_ecosystem.py
!test/unit/
test/unit/__pycache__/

# Recorded clip footage is never committed (externalize as a release asset)
public/clips/
*.webm
*.mp4.capture.json
*.capture.pending
*.capture.lock

# Graphify knowledge-graph tool output (local, machine-specific absolute paths)
graphify-out/

# Installed HyperFrames ecosystem skills (see skills-lock.json for the pinned set).
# Managed by `npx hyperframes skills update` / `npx skills add`; never vendored here.
.agents/
.claude/skills/
agent/
